<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>HR Analysis FLS</label>
    <description>Grants the analysis identity read FLS on classified fields so the tool's FieldDefinition/ComplianceGroup scan can see them.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>HealthRecord__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>HealthRecord__c.Patient_Name__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HealthRecord__c.Diagnosis__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
